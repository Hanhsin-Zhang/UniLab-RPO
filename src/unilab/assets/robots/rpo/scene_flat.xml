<mujoco model="rpo scene">
  <include file="rpo.xml"/>

  <statistic center="0 0 0.85" extent="1.6"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <!-- priority=2 (> the feet's 1) + condim=6 makes the floor the priority geom
        for foot-ground contact, so it dictates the friction (and keeps condim 6).
        This lets ground-friction domain randomization actually move the contact
        friction; otherwise the priority-1 feet would override the floor. -->
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" priority="2" condim="6" contype="1" conaffinity="15"/>
  </worldbody>

  <sensor>
    <contact name="left_foot_contact" geom1="left_foot_geom" geom2="floor" data="force"/>
    <contact name="right_foot_contact" geom1="right_foot_geom" geom2="floor" data="force"/>
  </sensor>


  
  <keyframe>
    <key
      name="stand"
      qpos="
        0 0 0.75  1 0 0 0
        0 0 -0.1 0.3 -0.2 0
        0 0 -0.1 0.3 -0.2 0
        0
        0.18 0.06 0 0.78 0
        0.18 -0.06 0 0.78 0"
      ctrl="
        0 0 -0.1 0.3 -0.2 0
        0 0 -0.1 0.3 -0.2 0
        0
        0.18 0.06 0 0.78 0
        0.18 -0.06 0 0.78 0"/>
  </keyframe>
</mujoco>
