<mujoco model="rpo scene">
  <include file="rpo.xml"/>

  <statistic center="0 0 0.85" extent="1.6"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <!-- priority=2 (> the feet's 1) + condim=6 makes the floor the priority geom
        for foot-ground contact, so it dictates the friction (and keeps condim 6).
        This lets ground-friction domain randomization actually move the contact
        friction; otherwise the priority-1 feet would override the floor. -->
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" priority="2" condim="6" contype="1" conaffinity="15"/>
  </worldbody>

  <sensor>
    <!-- foot contact now comes from the 5 sole capsules per foot.
         Corner spheres stay as non-colliding visual probes for foot-height estimation. -->
    <contact name="left_foot_contact_0"  geom1="left_fc0"  geom2="floor" data="found" num="1" reduce="mindist"/>
    <contact name="left_foot_contact_1"  geom1="left_fc1"  geom2="floor" data="found" num="1" reduce="mindist"/>
    <contact name="left_foot_contact_2"  geom1="left_fc2"  geom2="floor" data="found" num="1" reduce="mindist"/>
    <contact name="left_foot_contact_3"  geom1="left_fc3"  geom2="floor" data="found" num="1" reduce="mindist"/>
    <contact name="left_foot_contact_4"  geom1="left_fc4"  geom2="floor" data="found" num="1" reduce="mindist"/>
    <contact name="right_foot_contact_0" geom1="right_fc0" geom2="floor" data="found" num="1" reduce="mindist"/>
    <contact name="right_foot_contact_1" geom1="right_fc1" geom2="floor" data="found" num="1" reduce="mindist"/>
    <contact name="right_foot_contact_2" geom1="right_fc2" geom2="floor" data="found" num="1" reduce="mindist"/>
    <contact name="right_foot_contact_3" geom1="right_fc3" geom2="floor" data="found" num="1" reduce="mindist"/>
    <contact name="right_foot_contact_4" geom1="right_fc4" geom2="floor" data="found" num="1" reduce="mindist"/>

    <!-- termination contact: torso + base_link -->
    <contact name="torso_contact" geom1="torso_geom" geom2="floor" data="force"/>
    <contact name="base_contact"  geom1="base_geom"  geom2="floor" data="force"/>
    <!-- <contact name="left_thigh_yaw_contact" geom1="left_thigh_yaw_geom" geom2="floor" data="force"/>
    <contact name="left_thigh_roll_contact" geom1="left_thigh_roll_geom" geom2="floor" data="force"/>
    <contact name="right_thigh_yaw_contact" geom1="right_thigh_yaw_geom" geom2="floor" data="force"/>
    <contact name="right_thigh_roll_contact" geom1="right_thigh_roll_geom" geom2="floor" data="force"/> -->
    <!-- thigh_yaw and thigh_roll have no collision in URDF (commented out);
      removed their contact sensors to match IsaacLab training behavior. -->

    <!-- undesired contact (all non-foot bodies, matching roboparty regex "(?!.*ankle_roll.*).*") -->
    <contact name="left_thigh_pitch_contact"  geom1="left_thigh_pitch_geom"  geom2="floor" data="force"/>
    <contact name="right_thigh_pitch_contact" geom1="right_thigh_pitch_geom" geom2="floor" data="force"/>
    <contact name="left_knee_contact"         geom1="left_knee_geom"         geom2="floor" data="force"/>
    <contact name="right_knee_contact"        geom1="right_knee_geom"        geom2="floor" data="force"/>
    <contact name="left_arm_pitch_contact"    geom1="left_arm_pitch_geom"    geom2="floor" data="force"/>
    <contact name="left_arm_roll_contact"     geom1="left_arm_roll_geom"     geom2="floor" data="force"/>
    <contact name="left_arm_yaw_contact"      geom1="left_arm_yaw_geom"      geom2="floor" data="force"/>
    <contact name="left_elbow_pitch_contact"  geom1="left_elbow_pitch_geom"  geom2="floor" data="force"/>
    <contact name="right_arm_pitch_contact"   geom1="right_arm_pitch_geom"   geom2="floor" data="force"/>
    <contact name="right_arm_roll_contact"    geom1="right_arm_roll_geom"    geom2="floor" data="force"/>
    <contact name="right_arm_yaw_contact"     geom1="right_arm_yaw_geom"     geom2="floor" data="force"/>
    <contact name="right_elbow_pitch_contact" geom1="right_elbow_pitch_geom" geom2="floor" data="force"/>

    <contact name="thigh_pitch_self_contact"
      geom1="left_thigh_pitch_geom"
      geom2="right_thigh_pitch_geom"
      data="force"/>
    <contact name="knee_self_contact"
      geom1="left_knee_geom"
      geom2="right_knee_geom"
      data="force"/>
    <contact name="left_thigh_pitch_right_knee_self_contact"
      geom1="left_thigh_pitch_geom"
      geom2="right_knee_geom"
      data="force"/>
    <contact name="right_thigh_pitch_left_knee_self_contact"
      geom1="right_thigh_pitch_geom"
      geom2="left_knee_geom"
      data="force"/>
  </sensor>


  
  <keyframe>
    <key
      name="stand"
      qpos="
        0 0 0.78  1 0 0 0
        0 0 -0.1 0.3 -0.2 0
        0 0 -0.1 0.3 -0.2 0
        0
        0.18 0.15 0 0.78 0
        0.18 -0.15 0 0.78 0"
      ctrl="
        0 0 -0.1 0.3 -0.2 0
        0 0 -0.1 0.3 -0.2 0
        0
        0.18 0.15 0 0.78 0
        0.18 -0.15 0 0.78 0"/>
  </keyframe>
</mujoco>
